# Environment variables - DO NOT COMMIT THIS FILE
# Copy this to .env and fill in your values

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

SFL_API_URL=https://sfl.world/api/v1
SFL_API_KEY=optional_api_key_if_needed

# Telegram Bot (for push notifications - temporary until FCM)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Firebase Cloud Messaging (for Android app - future)
FCM_PROJECT_ID=your_firebase_project_id
FCM_PRIVATE_KEY=path_to_firebase_private_key.json

PORT=3000